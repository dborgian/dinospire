# Firebase — copy from Firebase Console > Project Settings > General > Your apps > SDK snippet
# Rename this file to .env.local and fill in the values.
#
# Setup steps:
# 1. console.firebase.google.com → Add project → "dinospire"
# 2. Add web app → copy the config below
# 3. Authentication → Sign-in method → Google → Enable
# 4. Firestore Database → Create database → production mode
#    → Rules tab → paste:
#      rules_version = '2';
#      service cloud.firestore {
#        match /databases/{database}/documents {
#          match /scores/{doc} {
#            allow read: if true;
#            allow write: if request.auth != null;
#          }
#        }
#      }
# 5. Firestore → Indexes → Composite → Add:
#    Collection: scores | Field: score DESC | Query scopes: Collection

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
