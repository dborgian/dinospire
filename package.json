{
  "name": "dinospire",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "generate:art": "tsx scripts/generate-card-art.ts",
    "generate:art:cards": "tsx scripts/generate-card-art.ts --type cards",
    "generate:art:enemies": "tsx scripts/generate-card-art.ts --type enemies",
    "generate:art:heroes": "tsx scripts/generate-card-art.ts --type heroes",
    "generate:art:relics": "tsx scripts/generate-card-art.ts --type relics",
    "generate:backgrounds": "tsx scripts/generate-arena-backgrounds.ts",
    "generate:fullcards": "tsx scripts/generate-full-cards.ts --hero borea",
    "generate:fullcards:rex": "tsx scripts/generate-full-cards.ts --hero rex",
    "generate:fullcards:veloce": "tsx scripts/generate-full-cards.ts --hero veloce"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "dexie": "^4.0.10",
    "firebase": "^12.14.0",
    "framer-motion": "^12.0.0",
    "immer": "^10.0.0",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
